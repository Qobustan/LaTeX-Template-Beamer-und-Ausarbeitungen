# ==============================================================================
# .gitignore
# ==============================================================================

# -----------------------
# LaTeX auxiliary files
# -----------------------
# These files are currently tracked in the repository as examples.
# Uncomment these lines to ignore them in your fork/copy.
#
# *.aux
# *.lof
# *.log
# *.lot
# *.fls
# *.out
# *.toc
# *.fmt
# *.fot
# *.cb
# *.cb2
# *.bbl
# *.blg
# *.bcf
# *.brf
# *.idx
# *.ilg
# *.ind
# *.glo
# *.gls
# *.ist
# *.acr
# *.alg
# *.nav
# *.snm
# *.synctex.gz
# *.fdb_latexmk
# *.run.xml
# *.auxlock
# *-blx.bib

# -----------------------
# Output / build folders
# -----------------------
build/
out/
dist/

# -----------------------
# Python
# -----------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
*.egg
venv/
env/
.venv/

# -----------------------
# Node.js (if any tools use it)
# -----------------------
node_modules/
npm-debug.log*

# -----------------------
# Editors / IDEs
# -----------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.project
.settings/

# -----------------------
# TeXstudio specific
# -----------------------
*.txs-profile
*.txs-undo

# -----------------------
# Legacy / debug
# -----------------------
legacy/debug

